# TrustLens Environment Variables
ENVIRONMENT=development
PROJECT_NAME=TrustLens

# FastAPI Configuration
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey_please_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# PostgreSQL Database Configuration (Sync connection for Psycopg2)
POSTGRES_SERVER=localhost
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens_password
POSTGRES_DB=trustlens_db
POSTGRES_PORT=5432
# Derived DATABASE_URI: postgresql://trustlens:trustlens_password@localhost:5432/trustlens_db
