# TrustLens Root Environment Variables (used for docker-compose)
APP_NAME=TrustLens
APP_ENV=production

# Backend Variables
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://trustlens:trustlens_password@db:5432/trustlens_db
JWT_SECRET_KEY=supersecretkey_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_FILE_SIZE_MB=25
CORS_ORIGINS=["https://trustlens-frontend.vercel.app", "http://localhost:5173"]

# Database Variables
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens_password
POSTGRES_DB=trustlens_db

# Frontend Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
